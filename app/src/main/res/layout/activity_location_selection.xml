<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safety_background"
    tools:context=".ui.LocationSelectionActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/back_button"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@color/safety_on_action"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
                app:backgroundTint="@null"
        android:drawableStart="@drawable/ic_ms_arrow_back"
        android:drawableTint="@color/safety_on_action"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomGuide" />

    <Button
        android:id="@+id/btnSaveDraft"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/outline_button"
        android:text="@string/save_as_draft"
        android:textAllCaps="false"
        android:textColor="@color/safety_text"
        android:textSize="14sp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        android:drawableStart="@drawable/ic_ms_save"
        android:drawableTint="@color/safety_text"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:text="Select Location"
        android:textColor="@color/safety_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSaveDraft" />

    <ScrollView
        android:id="@+id/locationsContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <Button
                android:id="@+id/btnLocationDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_button"
                android:gravity="center_vertical|start"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/select_location"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="18sp"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_location_on"
                android:drawableTint="@color/safety_text"
                android:drawablePadding="16dp"
                android:drawableEnd="@drawable/ic_ms_expand_more" />

            <HorizontalScrollView
                android:id="@+id/locationTableContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:visibility="gone">

                <TableLayout
                    android:id="@+id/locationTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <TableRow android:background="#EAEAEA">
                        <TextView
                            android:padding="12dp"
                            android:text="ID"
                            android:textColor="@color/safety_text"
                            android:textStyle="bold" />

                        <TextView
                            android:padding="12dp"
                            android:text="Location Name"
                            android:textColor="@color/safety_text"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/next_button"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/safety_on_action"
        android:textSize="18sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
                app:backgroundTint="@null"
        android:drawableStart="@drawable/ic_ms_arrow_forward"
        android:drawableTint="@color/safety_on_action"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@id/bottomGuide" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safety_background">

    <Button
        android:id="@+id/btnSaveDraft"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/outline_button"
        android:drawableStart="@drawable/ic_ms_save"
        android:drawableTint="@color/safety_text"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/save_as_draft"
        android:textAllCaps="false"
        android:textColor="@color/safety_text"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSaveDraft">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/select_report_type"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIncident"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:background="@drawable/outline_button"
                android:drawableStart="@drawable/ic_ms_personal_injury"
                android:drawableTint="@color/safety_text"
                android:drawablePadding="16dp"
                android:gravity="center_vertical|start"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="@string/report_type_incident"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnHazard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/outline_button"
                android:drawableStart="@drawable/ic_ms_warning"
                android:drawableTint="@color/safety_text"
                android:drawablePadding="16dp"
                android:gravity="center_vertical|start"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="@string/report_type_hazard"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnNearMiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/outline_button"
                android:drawableStart="@drawable/ic_ms_visibility"
                android:drawableTint="@color/safety_text"
                android:drawablePadding="16dp"
                android:gravity="center_vertical|start"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="@string/report_type_near_miss"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="148dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/back_button"
        android:drawableStart="@drawable/ic_ms_arrow_back"
        android:drawableTint="@color/safety_on_action"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@color/safety_on_action"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".ui.ReportTypeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="144dp"
                android:layout_height="56dp"
                android:background="@drawable/back_button"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Select Report Type"
                android:textColor="@android:color/black"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIncident"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="#D92D20"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="INCIDENT"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHazard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#F2B705"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="HAZARD"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNearMiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#168AAD"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="NEAR MISS"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

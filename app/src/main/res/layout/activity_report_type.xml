<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safety_background"
    tools:context=".ui.ReportTypeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="144dp"
                android:layout_height="56dp"
                android:background="@drawable/back_button"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="@color/safety_on_action"
                android:textSize="18sp"
                app:backgroundTint="@null" />
                <Button
                    android:id="@+id/btnSaveDraft"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/outline_button"
                    android:text="@string/save_as_draft"
                    android:textAllCaps="false"
                    android:textColor="@color/safety_text"
                    android:textSize="14sp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Select Report Type"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIncident"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="@drawable/outline_button"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="INCIDENT"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnHazard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/outline_button"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="HAZARD"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnNearMiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/outline_button"
                android:minHeight="96dp"
                android:padding="16dp"
                android:text="NEAR MISS"
                android:textAllCaps="false"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safety_background"
    tools:context=".ui.ReportVoiceActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/back_button"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@color/safety_on_action"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:backgroundTint="@null"
        android:drawableStart="@drawable/ic_ms_arrow_back"
        android:drawableTint="@color/safety_on_action"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomGuide" />

    <Button
        android:id="@+id/btnSaveDraft"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/outline_button"
        android:text="@string/save_as_draft"
        android:textAllCaps="false"
        android:textColor="@color/safety_text"
        android:textSize="14sp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        android:drawableStart="@drawable/ic_ms_save"
        android:drawableTint="@color/safety_text"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:text="@string/voice_heading"
        android:textColor="@color/safety_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSaveDraft" />

    <ScrollView
        android:id="@+id/voiceContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHeading">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                android:text="@string/voice_hint"
                android:textColor="@color/safety_text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/record_button"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="88dp"
                android:padding="16dp"
                android:stateListAnimator="@null"
                android:text="@string/record_voice_note"
                android:textAllCaps="false"
                android:textColor="@color/safety_on_action"
                android:textSize="22sp"
                android:textStyle="bold"
        app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_mic"
                android:drawableTint="@color/safety_on_action"
                android:drawablePadding="16dp"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/tvRecordTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="0:00"
                android:textColor="@color/safety_text"
                android:textSize="18sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/audioPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/next_button"
        android:enabled="false"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/safety_on_action"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="@null"
        android:drawableStart="@drawable/ic_ms_arrow_forward"
        android:drawableTint="@color/safety_on_action"
        android:drawablePadding="8dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@id/bottomGuide" />

</androidx.constraintlayout.widget.ConstraintLayout>

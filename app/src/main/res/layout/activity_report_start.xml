<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safety_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="144dp"
                android:layout_height="56dp"
                android:background="@drawable/back_button"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="@color/safety_on_action"
                android:textSize="18sp"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_arrow_back"
                android:drawableTint="@color/safety_on_action"
                android:drawablePadding="8dp"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/report_start_title"
                android:textColor="@color/safety_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/report_start_explanation"
                android:textColor="@color/safety_text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnNewReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:background="@drawable/button_yellow"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="100dp"
                android:padding="16dp"
                android:stateListAnimator="@null"
                android:text="@string/new_report"
                android:textColor="@color/safety_on_action"
                android:textSize="24sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_note_add"
                android:drawableTint="@color/safety_on_action"
                android:drawablePadding="16dp"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnResumeReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_yellow"
                android:enabled="false"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="100dp"
                android:padding="16dp"
                android:stateListAnimator="@null"
                android:text="@string/resume_report"
                android:textColor="@color/safety_on_action"
                android:textSize="24sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_history"
                android:drawableTint="@color/safety_on_action"
                android:drawablePadding="16dp"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#000000"
    tools:context=".ui.ReportImagesActivity">

    <ImageView
        android:id="@+id/fullscreenImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Fullscreen saved image"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDeleteFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="Delete"
            android:textColor="@color/safety_on_action"
            android:textAllCaps="false"
            android:background="@drawable/danger_button"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnKeepFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Keep"
            android:textColor="@color/safety_text"
            android:textAllCaps="false"
            android:background="@drawable/outline_button"
            app:backgroundTint="@null" />

    </LinearLayout>

</FrameLayout>